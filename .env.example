# Copy to .env for local development (never commit .env)
# On Vercel: Project → Settings → Environment Variables

# Formspree form endpoint (https://formspree.io)
FORMSPREE_ENDPOINT=

# Analytics: plausible | ga4 | (empty = disabled)
ANALYTICS_PROVIDER=

# Plausible domain (when ANALYTICS_PROVIDER=plausible)
PLAUSIBLE_DOMAIN=mkofman.com

# Google Analytics 4 ID (when ANALYTICS_PROVIDER=ga4)
GA4_ID=
